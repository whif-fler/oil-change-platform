# Supabase PostgreSQL — transaction pooler (port 6543), used by the application at runtime
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL — direct connection (port 5432), used for Prisma migrations
# Uses the Supavisor session pooler when the direct IPv6 endpoint is unavailable
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Owner authentication
# Generate with: npx tsx scripts/generate-password-hash.ts
OWNER_USERNAME="admin"
OWNER_PASSWORD_SALT=""
OWNER_PASSWORD_HASH=""
OWNER_SESSION_SECRET=""
